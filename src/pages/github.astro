---
import GitHubWorldShowcase from "@components/features/github-showcase/GitHubWorldShowcase.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import contributionSnapshot from "../data/github-contributions.json";
import {
	featuredGitHubRepositories,
	githubProfile,
	githubProjectCategories,
} from "../data/github-showcase";

interface GitHubProfileApi {
	login: string;
	avatar_url: string;
	html_url: string;
	public_repos: number;
	followers: number;
	following: number;
}

interface GitHubRepositoryApi {
	name: string;
	full_name: string;
	html_url: string;
	description: string | null;
	homepage: string | null;
	stargazers_count: number;
	forks_count: number;
	language: string | null;
	updated_at: string;
	private: boolean;
	fork: boolean;
	archived: boolean;
}

interface GitHubEventApi {
	type: string;
	created_at: string;
	repo?: { name: string };
}

async function fetchGitHubJson<T>(path: string): Promise<T | null> {
	try {
		const response = await fetch("https://api.github.com" + path, {
			headers: {
				Accept: "application/vnd.github+json",
				"X-GitHub-Api-Version": "2022-11-28",
				"User-Agent": "KatelyaBlog/1.0",
			},
			signal: AbortSignal.timeout(3500),
		});
		if (!response.ok) return null;
		return (await response.json()) as T;
	} catch {
		return null;
	}
}

function formatDate(value: string): string {
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "日期未知";
	return new Intl.DateTimeFormat("zh-CN", {
		timeZone: "Asia/Shanghai",
		month: "short",
		day: "numeric",
	}).format(date);
}

function compactNumber(value: number): string {
	return new Intl.NumberFormat("en", {
		notation: "compact",
		maximumFractionDigits: 1,
	}).format(value);
}

const [profileData, repositoryPayload, eventsData, decoTvData] = await Promise.all([
	fetchGitHubJson<GitHubProfileApi>("/users/katelya77"),
	fetchGitHubJson<GitHubRepositoryApi[]>("/users/katelya77/repos?per_page=100&sort=updated"),
	fetchGitHubJson<GitHubEventApi[]>("/users/katelya77/events/public?per_page=100"),
	fetchGitHubJson<GitHubRepositoryApi>("/repos/Decohererk/DecoTV"),
]);

// Only public, non-fork, non-archived repositories are eligible for the showcase.
// If the API is temporarily unavailable, the curated public-facing descriptions
// remain available, but live metrics are shown as unavailable.
const publicRepositories = Array.isArray(repositoryPayload)
	? repositoryPayload.filter((repo) => repo && repo.private === false && !repo.fork && !repo.archived)
	: null;
const repositoryByName = new Map<string, GitHubRepositoryApi>(
	(publicRepositories ?? []).map((repo) => [repo.name.toLowerCase(), repo] as const),
);
const verifiedOrgRepository = decoTvData?.full_name === "Decohererk/DecoTV" &&
	decoTvData.private === false && !decoTvData.fork && !decoTvData.archived
	? decoTvData : null;
const featuredRepositories = featuredGitHubRepositories
	// Keep the known public organization project present if the API rate-limits.
	.filter((item) => item.owner === "Decohererk" || !publicRepositories || repositoryByName.has(item.name.toLowerCase()))
	.map((item) => {
		const owner = item.owner || "katelya77";
		const live = item.owner === "Decohererk"
			? verifiedOrgRepository
			: repositoryByName.get(item.name.toLowerCase());
		return {
			...item,
			fullName: owner + "/" + item.name,
			url: live?.html_url || "https://github.com/" + owner + "/" + item.name,
			stars: live?.stargazers_count ?? null,
			forks: live?.forks_count ?? null,
			language: live?.language ?? null,
			updatedAt: live?.updated_at ? formatDate(live.updated_at) : "",
			homepage: item.homepage || live?.homepage || "",
		};
	});

const featuredNames = new Set(featuredRepositories.filter((repo) => repo.fullName.startsWith("katelya77/")).map((repo) => repo.name.toLowerCase()));
const additionalRepositories = (publicRepositories ?? [])
	.filter((repo) => !featuredNames.has(repo.name.toLowerCase()))
	.sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at))
	.slice(0, 8)
	.map((repo) => ({
		name: repo.name,
		url: repo.html_url,
		description: repo.description || "暂无公开简介",
		language: repo.language,
		stars: repo.stargazers_count,
		updatedAt: formatDate(repo.updated_at),
	}));

const totalStars = publicRepositories
	? publicRepositories.reduce((total, repo) => total + Number(repo.stargazers_count || 0), 0) + (verifiedOrgRepository?.stargazers_count ?? 0)
	: null;
const activityPeriods = contributionSnapshot.source === "github-graphql-contributionsCollection"
	? contributionSnapshot.periods
	: [];
const rollingContributions = activityPeriods.find((period) => period.id === "rolling");

const stats = [
	{
		label: "公开仓库",
		value: profileData?.public_repos === undefined && !publicRepositories ? "—" : (profileData?.public_repos ?? publicRepositories?.length ?? 0) + 1,
		detail: "Personal + curated public DecoTV",
	},
	{
		label: "项目 Stars",
		value: totalStars === null ? "—" : compactNumber(totalStars),
		detail: verifiedOrgRepository ? "Personal + Decohererk/DecoTV" : "Personal only; DecoTV stats unavailable",
	},
	{
		label: "关注者",
		value: profileData?.followers ?? "—",
		detail: "GitHub followers",
	},
	{
		label: "年度贡献",
		value: rollingContributions ? compactNumber(rollingContributions.totalContributions) : "—",
		detail: "GitHub official contribution calendar · past year",
	},
];

const filterTabs = githubProjectCategories
	.map((category) => ({
		...category,
		count:
			category.value === "all"
				? featuredRepositories.length
				: featuredRepositories.filter((repo) => repo.category === category.value).length,
	}))
	.filter((category) => category.value === "all" || category.count > 0);

const eventLabels: Record<string, string> = {
	PushEvent: "推送了代码",
	PullRequestEvent: "更新了 Pull Request",
	IssuesEvent: "参与了 Issue",
	ReleaseEvent: "发布了版本",
	CreateEvent: "创建了公开仓库内容",
	WatchEvent: "Star 了一个仓库",
	ForkEvent: "Fork 了一个仓库",
	PublicEvent: "公开了一个仓库",
};

const recentActivity = (eventsData ?? [])
	.filter((event) => event.repo?.name && eventLabels[event.type])
	.slice(0, 8)
	.map((event) => ({
		label: eventLabels[event.type],
		repository: event.repo?.name || "",
		url: "https://github.com/" + (event.repo?.name || ""),
		date: formatDate(event.created_at),
	}));

// The contribution calendar is a separately refreshed official GraphQL snapshot.
// Public Events remains a recent activity feed, not a contribution count.

const profile = {
	...githubProfile,
	avatar: profileData?.avatar_url || githubProfile.avatar,
	url: profileData?.html_url || githubProfile.url,
};
const associatedOrganization = {
	name: "Decohererk",
	url: "https://github.com/Decohererk",
	repositoryUrl: "https://github.com/Decohererk/DecoTV",
	repositoryName: "Decohererk/DecoTV",
	stars: verifiedOrgRepository?.stargazers_count ?? null,
	forks: verifiedOrgRepository?.forks_count ?? null,
};
const pageDescription =
	"GitHub 个人开发者主页：公开项目、仓库 Stars、完整年度贡献日历、历史年份、近期公开活动与 Ovio-inspired 动效展示，包含 Minimal、Craft、Retro、Toy 四种交互风格。";
---

<MainGridLayout title="GitHub" description={pageDescription}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div class="w-full min-w-0">
		<GitHubWorldShowcase
			client:visible
			profile={profile}
			stats={stats}
			featuredRepositories={featuredRepositories}
			additionalRepositories={additionalRepositories}
			recentActivity={recentActivity}
			activityPeriods={activityPeriods}
			filterTabs={filterTabs}
			associatedOrganization={associatedOrganization}
		/>
	</div>
</MainGridLayout>
