---
import { Icon } from "astro-icon/components";

import { FilterTabs } from "@components/atoms/filter-tabs";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	featuredGitHubRepositories,
	githubProfile,
	githubProjectCategories,
} from "../data/github-showcase";

interface GitHubProfileApi {
	login: string;
	avatar_url: string;
	html_url: string;
	public_repos: number;
	followers: number;
	following: number;
}

interface GitHubRepositoryApi {
	name: string;
	full_name: string;
	html_url: string;
	description: string | null;
	homepage: string | null;
	stargazers_count: number;
	forks_count: number;
	language: string | null;
	updated_at: string;
	private: boolean;
	fork: boolean;
	archived: boolean;
}

interface GitHubEventApi {
	type: string;
	created_at: string;
	repo?: { name: string };
}

async function fetchGitHubJson<T>(path: string): Promise<T | null> {
	try {
		const response = await fetch(`https://api.github.com${path}`, {
			headers: {
				Accept: "application/vnd.github+json",
				"X-GitHub-Api-Version": "2022-11-28",
				"User-Agent": "KatelyaBlog/1.0",
			},
			signal: AbortSignal.timeout(3500),
		});
		if (!response.ok) return null;
		return (await response.json()) as T;
	} catch {
		return null;
	}
}

function formatDate(value: string): string {
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "日期未知";
	return new Intl.DateTimeFormat("zh-CN", {
		timeZone: "Asia/Shanghai",
		month: "short",
		day: "numeric",
	}).format(date);
}

function compactNumber(value: number): string {
	return new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(value);
}

const [profileData, repositoryPayload, eventsData] = await Promise.all([
	fetchGitHubJson<GitHubProfileApi>("/users/katelya77"),
	fetchGitHubJson<GitHubRepositoryApi[]>("/users/katelya77/repos?per_page=100&sort=updated"),
	fetchGitHubJson<GitHubEventApi[]>("/users/katelya77/events/public?per_page=100"),
]);

// The unauthenticated public endpoint never returns private repositories. Keep
// an explicit visibility filter as a second boundary before rendering cards.
const publicRepositories = Array.isArray(repositoryPayload)
	? repositoryPayload.filter((repo) => repo && repo.private === false && !repo.fork && !repo.archived)
	: null;
const repositoryByName = new Map<string, GitHubRepositoryApi>(
	(publicRepositories ?? []).map((repo) => [repo.name.toLowerCase(), repo] as const),
);
const featuredRepositories = featuredGitHubRepositories
	.filter((item) => !publicRepositories || repositoryByName.has(item.name.toLowerCase()))
	.map((item) => {
		const live = repositoryByName.get(item.name.toLowerCase());
		return {
			...item,
			fullName: `katelya77/${item.name}`,
			url: live?.html_url || `https://github.com/katelya77/${item.name}`,
			stars: live?.stargazers_count ?? null,
			forks: live?.forks_count ?? null,
			language: live?.language ?? null,
			updatedAt: live?.updated_at ?? "",
			homepage: item.homepage || live?.homepage || "",
		};
	});

const featuredNames = new Set(featuredRepositories.map((repo) => repo.name.toLowerCase()));
const additionalRepositories = (publicRepositories ?? [])
	.filter((repo) => !featuredNames.has(repo.name.toLowerCase()))
	.sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at))
	.slice(0, 8);

const totalStars = publicRepositories
	? publicRepositories.reduce((total, repo) => total + Number(repo.stargazers_count || 0), 0)
	: null;
const stats = [
	{
		label: "公开仓库",
		value: profileData?.public_repos ?? publicRepositories?.length ?? "—",
		detail: "Public repositories",
	},
	{
		label: "项目 Stars",
		value: totalStars === null ? "—" : compactNumber(totalStars),
		detail: "Active public non-fork repositories",
	},
	{
		label: "关注者",
		value: profileData?.followers ?? "—",
		detail: "GitHub followers",
	},
	{
		label: "公开动态",
		value: eventsData === null ? "—" : eventsData.length,
		detail: "Latest public events",
	},
];

const filterTabs = githubProjectCategories.map((category) => ({
	...category,
	count:
		category.value === "all"
			? featuredRepositories.length
			: featuredRepositories.filter((repo) => repo.category === category.value).length,
}));

const eventLabels: Record<string, string> = {
	PushEvent: "推送了代码",
	PullRequestEvent: "更新了 Pull Request",
	IssuesEvent: "参与了 Issue",
	ReleaseEvent: "发布了版本",
	CreateEvent: "创建了公开仓库内容",
	WatchEvent: "Star 了一个仓库",
	ForkEvent: "Fork 了一个仓库",
	PublicEvent: "公开了一个仓库",
};

const recentActivity = (eventsData ?? [])
	.filter((event) => event.repo?.name && eventLabels[event.type])
	.slice(0, 8)
	.map((event) => ({
		label: eventLabels[event.type],
		repository: event.repo?.name || "",
		url: `https://github.com/${event.repo?.name || ""}`,
		date: formatDate(event.created_at),
	}));

// GitHub's public Events API returns at most 100 recent events. Days before
// the oldest returned event are marked unknown rather than incorrectly shown
// as zero activity.
const eventCounts = new Map<string, number>();
for (const event of eventsData ?? []) {
	const date = new Date(event.created_at);
	if (Number.isNaN(date.getTime())) continue;
	const key = date.toISOString().slice(0, 10);
	eventCounts.set(key, (eventCounts.get(key) ?? 0) + 1);
}

const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const activityStart = new Date(today);
activityStart.setUTCDate(activityStart.getUTCDate() - 90);
activityStart.setUTCDate(activityStart.getUTCDate() - activityStart.getUTCDay());
const activityDayCount = Math.floor((today.getTime() - activityStart.getTime()) / 86_400_000) + 1;
const oldestEventTime =
	eventsData && eventsData.length >= 100
		? Math.min(...eventsData.map((event) => Date.parse(event.created_at)).filter(Number.isFinite))
		: null;
const activityDays = Array.from({ length: activityDayCount }, (_, index) => {
	const date = new Date(activityStart);
	date.setUTCDate(activityStart.getUTCDate() + index);
	const key = date.toISOString().slice(0, 10);
	const known =
		eventsData !== null &&
		(oldestEventTime === null || date.getTime() >= oldestEventTime);
	const count = known ? (eventCounts.get(key) ?? 0) : null;
	const level =
		count === null ? "unknown" : count === 0 ? "0" : count === 1 ? "1" : count <= 3 ? "2" : "3";
	return { date: key, count, level };
});
const activityWeeks = Array.from(
	{ length: Math.ceil(activityDays.length / 7) },
	(_, index) => activityDays.slice(index * 7, index * 7 + 7),
);

const profileAvatar = profileData?.avatar_url || githubProfile.avatar;
const profileUrl = profileData?.html_url || githubProfile.url;
const pageDescription =
	"GitHub 项目、公开仓库、开发活动与开源作品。记录每一次构建，也记录持续迭代的过程。";
---

<MainGridLayout title="GitHub" description={pageDescription}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div class="github-page w-full min-w-0">
		<section class="github-hero card-base">
			<div class="github-hero-copy">
				<div class="github-eyebrow">
					<span class="github-live-dot"></span>
					OPEN SOURCE · BUILD IN PUBLIC
				</div>
				<div class="github-identity">
					<img
						class="github-avatar"
						src={profileAvatar}
						alt="Katelya 的 GitHub 头像"
						width="76"
						height="76"
						loading="eager"
						decoding="async"
					/>
					<div class="min-w-0">
						<h1>{githubProfile.displayName}<span class="github-handle">@{githubProfile.username}</span></h1>
						<p>{githubProfile.bio}</p>
					</div>
				</div>
				<p class="github-tagline">{githubProfile.tagline}</p>
				<div class="github-hero-actions">
					<a class="github-primary-link" href={profileUrl} target="_blank" rel="noopener noreferrer">
						<Icon name="fa7-brands:github" />
						访问 GitHub 主页
						<Icon name="material-symbols:arrow-outward-rounded" />
					</a>
					<a class="github-secondary-link" href="/projects/">浏览项目总览</a>
				</div>
			</div>
			<div class="github-hero-mark" aria-hidden="true">
				<Icon name="fa7-brands:github" />
				<span>CODE / CREATE / REPEAT</span>
			</div>
		</section>

		<section class="github-stats-grid" aria-label="GitHub 公开统计">
			{stats.map((stat) => (
				<div class="github-stat-card card-base">
					<span>{stat.label}</span>
					<strong>{stat.value}</strong>
					<small>{stat.detail}</small>
				</div>
			))}
		</section>

		<section class="github-panel card-base">
			<div class="github-section-heading">
				<div>
					<span class="github-kicker">ACTIVITY / PUBLIC SIGNALS</span>
					<h2>近期公开活动</h2>
					<p>根据 GitHub Public Events API 汇总的公开事件时间分布。</p>
				</div>
				<span class="github-data-note">
					{eventsData === null ? "暂时无法同步" : `最近 ${eventsData.length} 条事件`}
				</span>
			</div>

			<div class="github-activity-wrap">
				<div class="github-weekdays" aria-hidden="true">
					<span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
				</div>
				<div class="github-activity-grid" role="img" aria-label="最近公开事件的日期分布；灰色虚线表示 API 数据未覆盖的日期">
					{activityWeeks.map((week) => (
						<div class="github-activity-week">
							{week.map((day) => (
								<span
									class="github-activity-cell"
									data-level={day.level}
									title={day.count === null ? `${day.date} · 数据未覆盖` : `${day.date} · ${day.count} 条公开事件`}
									aria-label={day.count === null ? `${day.date} 数据未覆盖` : `${day.date} ${day.count} 条公开事件`}
								></span>
							))}
						</div>
					))}
				</div>
			</div>
			<div class="github-activity-legend">
				<span>少</span>
				<i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="unknown"></i>
				<span>多</span>
			</div>
			<p class="github-footnote">
				说明：这里只展示公开事件样本，不等同于 GitHub 全年贡献统计，也不包含私有仓库活动。API 最多返回 100 条事件；未覆盖日期会明确标记。
			</p>
		</section>

		<section class="github-repositories">
			<PageHeader
				title="精选仓库"
				subtitle="从实际公开仓库中挑选值得持续维护和展示的作品。"
			/>
			<FilterTabs tabs={filterTabs} dataAttr="category" class="github-filter-tabs" />
			<div id="projects-grid" class="github-repo-grid">
				{featuredRepositories.map((repo) => (
					<article class="github-repo-card card-base" data-category={repo.category}>
						<div class="github-repo-topline">
							<span class="github-repo-icon"><Icon name="fa7-brands:github" /></span>
							<span class="github-repo-category">{repo.category}</span>
						</div>
						<h3><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.title}</a></h3>
						<p class="github-repo-description">{repo.description}</p>
						<div class="github-tech-stack">
							{repo.techStack.map((tech) => <span>{tech}</span>)}
						</div>
						<div class="github-repo-metrics">
							{repo.language && <span class="github-language"><i></i>{repo.language}</span>}
							{repo.stars !== null && <span><Icon name="material-symbols:star-rounded" />{compactNumber(repo.stars)}</span>}
							{repo.forks !== null && <span><Icon name="material-symbols:call-split-rounded" />{compactNumber(repo.forks)}</span>}
							{repo.updatedAt && <span>更新于 {formatDate(repo.updatedAt)}</span>}
						</div>
						<div class="github-repo-actions">
							<a href={repo.url} target="_blank" rel="noopener noreferrer">查看源码 <Icon name="material-symbols:arrow-outward-rounded" /></a>
							{repo.homepage && <a href={repo.homepage} target="_blank" rel="noopener noreferrer">在线体验 <Icon name="material-symbols:open-in-new-rounded" /></a>}
							<a href={`https://star-history.com/#${repo.fullName}&Date`} target="_blank" rel="noopener noreferrer">Star History</a>
						</div>
					</article>
				))}
			</div>
			{featuredRepositories.length === 0 && (
				<div class="github-empty-state">暂时无法确认精选仓库的公开状态，请直接访问 GitHub 主页查看。</div>
				)}
		</section>

		{additionalRepositories.length > 0 && (
			<section class="github-panel card-base">
				<div class="github-section-heading">
					<div>
						<span class="github-kicker">MORE REPOSITORIES</span>
						<h2>其他公开仓库</h2>
						<p>自动同步公开、非 Fork 且未归档的仓库，按最近更新时间排序。</p>
					</div>
					<a class="github-text-link" href={profileUrl} target="_blank" rel="noopener noreferrer">全部仓库 <Icon name="material-symbols:arrow-outward-rounded" /></a>
				</div>
				<div class="github-more-repos">
					{additionalRepositories.map((repo) => (
						<a class="github-more-repo" href={repo.html_url} target="_blank" rel="noopener noreferrer">
							<div class="github-more-repo-main">
								<strong>{repo.name}</strong>
								<span>{repo.description || "暂无公开简介"}</span>
							</div>
							<div class="github-more-repo-meta">
								{repo.language && <span>{repo.language}</span>}
								<span><Icon name="material-symbols:star-rounded" />{compactNumber(repo.stargazers_count)}</span>
								<span>{formatDate(repo.updated_at)}</span>
							</div>
						</a>
					))}
				</div>
			</section>
		)}

		<section class="github-panel card-base">
			<div class="github-section-heading">
				<div>
					<span class="github-kicker">RECENT EVENTS</span>
					<h2>开发动态</h2>
					<p>只展示 GitHub 返回的公开事件，不读取或展示私有仓库活动。</p>
				</div>
			</div>
			{recentActivity.length > 0 ? (
				<div class="github-event-list">
					{recentActivity.map((event) => (
						<a class="github-event" href={event.url} target="_blank" rel="noopener noreferrer">
							<span class="github-event-mark"><Icon name="material-symbols:commit-rounded" /></span>
							<span class="github-event-copy"><strong>{event.label}</strong><small>{event.repository}</small></span>
							<time>{event.date}</time>
						</a>
					))}
				</div>
			) : (
				<p class="github-empty-state">
					{eventsData === null ? "GitHub 公开动态暂时无法同步，请稍后重试。" : "暂时没有可展示的近期公开事件。"}
				</p>
			)}
		</section>

		<p class="github-last-sync">
			公开数据由 GitHub API 在站点构建时同步；数据不可用时优先保留静态项目介绍，不阻塞页面渲染。
		</p>
	</div>
</MainGridLayout>

<style>
	.github-page {
		display: grid;
		gap: 1.35rem;
		min-width: 0;
	}

	.github-hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 270px;
		overflow: hidden;
		padding: clamp(1.35rem, 4vw, 2.6rem);
		border: 1px solid var(--line-divider);
		background:
			radial-gradient(circle at 92% 18%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 34%),
			linear-gradient(135deg, color-mix(in srgb, var(--primary) 7%, transparent), transparent 65%);
		isolation: isolate;
	}

	.github-hero-copy {
		position: relative;
		z-index: 1;
		max-width: 760px;
	}

	.github-eyebrow,
	.github-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.13em;
	}

	.github-live-dot {
		width: 0.48rem;
		height: 0.48rem;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 14%, transparent);
	}

	.github-identity {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-top: 1.1rem;
	}

	.github-avatar {
		width: 76px;
		height: 76px;
		flex: 0 0 76px;
		border: 3px solid color-mix(in srgb, var(--primary) 25%, var(--card-bg, white));
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 8px 26px rgba(0, 0, 0, 0.12);
	}

	.github-identity h1 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.65rem;
		margin: 0;
		color: var(--deep-text);
		font-size: clamp(1.8rem, 4vw, 2.65rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.15;
	}

	.github-handle {
		color: var(--primary);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.github-identity p {
		max-width: 620px;
		margin: 0.6rem 0 0;
		color: var(--content-meta);
		font-size: 0.96rem;
		line-height: 1.8;
	}

	.github-tagline {
		margin: 1.2rem 0 1.35rem;
		color: var(--content-meta);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
	}

	.github-hero-actions,
	.github-repo-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.github-primary-link,
	.github-secondary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 42px;
		padding: 0.65rem 1rem;
		border-radius: 0.8rem;
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
	}

	.github-primary-link {
		background: var(--primary);
		color: white;
		box-shadow: 0 8px 22px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.github-secondary-link {
		border: 1px solid var(--line-divider);
		background: color-mix(in srgb, var(--card-bg, white) 70%, transparent);
		color: var(--deep-text);
	}

	.github-primary-link:hover,
	.github-secondary-link:hover {
		transform: translateY(-2px);
	}

	.github-hero-mark {
		position: relative;
		z-index: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		padding: 1rem;
		color: color-mix(in srgb, var(--primary) 16%, transparent);
	}

	.github-hero-mark :global(svg) {
		width: clamp(7rem, 17vw, 13rem);
		height: auto;
	}

	.github-hero-mark span {
		color: var(--content-meta);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		white-space: nowrap;
	}

	.github-stats-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.github-stat-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--line-divider);
	}

	.github-stat-card > span {
		color: var(--content-meta);
		font-size: 0.8rem;
	}

	.github-stat-card strong {
		color: var(--deep-text);
		font-size: clamp(1.45rem, 3vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	.github-stat-card small {
		color: var(--content-meta);
		font-size: 0.68rem;
	}

	.github-panel {
		min-width: 0;
		padding: clamp(1.15rem, 3vw, 1.7rem);
		border: 1px solid var(--line-divider);
	}

	.github-section-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.2rem;
	}

	.github-section-heading h2 {
		margin: 0.35rem 0 0.25rem;
		color: var(--deep-text);
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.025em;
	}

	.github-section-heading p {
		margin: 0;
		color: var(--content-meta);
		font-size: 0.82rem;
		line-height: 1.65;
	}

	.github-data-note {
		flex: 0 0 auto;
		padding: 0.4rem 0.65rem;
		border: 1px solid var(--line-divider);
		border-radius: 999px;
		color: var(--content-meta);
		font-size: 0.7rem;
		white-space: nowrap;
	}

	.github-activity-wrap {
		display: flex;
		align-items: stretch;
		gap: 0.5rem;
		max-width: 100%;
		overflow-x: auto;
		padding: 0.25rem 0 0.45rem;
	}

	.github-weekdays {
		display: grid;
		grid-template-rows: repeat(7, 10px);
		gap: 4px;
		padding-top: 1px;
		color: var(--content-meta);
		font-size: 0.58rem;
		line-height: 10px;
	}

