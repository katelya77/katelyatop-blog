---
import GitHubWorldShowcase from "@components/features/github-showcase/GitHubWorldShowcase.svelte";
import { fetchPublicContributionCalendar } from "../../scripts/github-public-contributions.mjs";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	featuredGitHubRepositories,
	githubProfile,
	githubProjectCategories,
} from "../data/github-showcase";

interface GitHubProfileApi {
	login: string;
	avatar_url: string;
	html_url: string;
	public_repos: number;
	followers: number;
	following: number;
}

interface GitHubRepositoryApi {
	name: string;
	full_name: string;
	html_url: string;
	description: string | null;
	homepage: string | null;
	stargazers_count: number;
	forks_count: number;
	language: string | null;
	updated_at: string;
	private: boolean;
	fork: boolean;
	archived: boolean;
}

interface GitHubEventApi {
	type: string;
	created_at: string;
	repo?: { name: string };
}

async function fetchGitHubJson<T>(path: string): Promise<T | null> {
	try {
		const response = await fetch("https://api.github.com" + path, {
			headers: {
				Accept: "application/vnd.github+json",
				"X-GitHub-Api-Version": "2022-11-28",
				"User-Agent": "KatelyaBlog/1.0",
			},
			signal: AbortSignal.timeout(3500),
		});
		if (!response.ok) return null;
		return (await response.json()) as T;
	} catch {
		return null;
	}
}

function formatDate(value: string): string {
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "日期未知";
	return new Intl.DateTimeFormat("zh-CN", {
		timeZone: "Asia/Shanghai",
		month: "short",
		day: "numeric",
	}).format(date);
}

function compactNumber(value: number): string {
	return new Intl.NumberFormat("en", {
		notation: "compact",
		maximumFractionDigits: 1,
	}).format(value);
}

const [profileData, repositoryPayload, orgRepositoryPayload, eventsData, contributionCalendar] = await Promise.all([
	fetchGitHubJson<GitHubProfileApi>("/users/katelya77"),
	fetchGitHubJson<GitHubRepositoryApi[]>("/users/katelya77/repos?per_page=100&sort=updated"),
	fetchGitHubJson<GitHubRepositoryApi[]>("/orgs/Decohererk/repos?per_page=100&sort=updated"),
	fetchGitHubJson<GitHubEventApi[]>("/users/katelya77/events/public?per_page=100"),
	fetchPublicContributionCalendar(),
]);

// Only public, non-fork, non-archived repositories are eligible for the showcase.
// If the API is temporarily unavailable, the curated public-facing descriptions
// remain available, but live metrics are shown as unavailable.
const publicRepositories = Array.isArray(repositoryPayload)
	? repositoryPayload.filter((repo) => repo && repo.private === false && !repo.fork && !repo.archived)
	: null;
const publicOrgRepositories = Array.isArray(orgRepositoryPayload)
	? orgRepositoryPayload.filter((repo) => repo && repo.private === false && !repo.fork && !repo.archived)
	: null;
const allPublicProjects = [
	...(publicRepositories ?? []),
	...(publicOrgRepositories ?? []),
];
const repositoryByName = new Map<string, GitHubRepositoryApi>(
	allPublicProjects.map((repo) => [repo.full_name.toLowerCase(), repo] as const),
);
const featuredRepositories = featuredGitHubRepositories
	.filter((item) => {
		const owner = item.owner || "katelya77";
		// Keep curated projects visible when an API is temporarily unavailable,
		// but do not invent live metrics or an organization's ownership.
		return owner === "Decohererk"
			? !publicOrgRepositories || repositoryByName.has((owner + "/" + item.name).toLowerCase())
			: !publicRepositories || repositoryByName.has((owner + "/" + item.name).toLowerCase());
	})
	.map((item) => {
		const owner = item.owner || "katelya77";
		const fullName = owner + "/" + item.name;
		const live = repositoryByName.get(fullName.toLowerCase());
		return {
			...item,
			fullName,
			url: live?.html_url || "https://github.com/" + fullName,
			stars: live?.stargazers_count ?? null,
			forks: live?.forks_count ?? null,
			language: live?.language ?? null,
			updatedAt: live?.updated_at ? formatDate(live.updated_at) : "",
			homepage: item.homepage || live?.homepage || "",
		};
	});

const featuredNames = new Set(featuredRepositories.map((repo) => repo.fullName.toLowerCase()));
const additionalRepositories = allPublicProjects
	.filter((repo) => !featuredNames.has(repo.full_name.toLowerCase()))
	.sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at))
	.slice(0, 8)
	.map((repo) => ({
		name: repo.name,
		url: repo.html_url,
		description: repo.description || "暂无公开简介",
		language: repo.language,
		stars: repo.stargazers_count,
		updatedAt: formatDate(repo.updated_at),
	}));

const totalStars = publicRepositories && publicOrgRepositories
	? allPublicProjects.reduce((total, repo) => total + Number(repo.stargazers_count || 0), 0)
	: publicRepositories
		? publicRepositories.reduce((total, repo) => total + Number(repo.stargazers_count || 0), 0)
		: null;
const stats = [
	{
		label: "个人仓库",
		value: profileData?.public_repos ?? publicRepositories?.length ?? "—",
		detail: "Public repositories",
	},
	{
		label: "项目 Stars",
		value: totalStars === null ? "—" : compactNumber(totalStars),
		detail: "Personal + Decohererk (when available)",
	},
	{
		label: "关注者",
		value: profileData?.followers ?? "—",
		detail: "GitHub followers",
	},
	{
		label: "公开动态",
		value: eventsData === null ? "—" : eventsData.length,
		detail: "Sampled public events (up to 100)",
	},
];

const filterTabs = githubProjectCategories
	.map((category) => ({
		...category,
		count:
			category.value === "all"
				? featuredRepositories.length
				: featuredRepositories.filter((repo) => repo.category === category.value).length,
	}))
	.filter((category) => category.value === "all" || category.count > 0);

const eventLabels: Record<string, string> = {
	PushEvent: "推送了代码",
	PullRequestEvent: "更新了 Pull Request",
	IssuesEvent: "参与了 Issue",
	ReleaseEvent: "发布了版本",
	CreateEvent: "创建了公开仓库内容",
	WatchEvent: "Star 了一个仓库",
	ForkEvent: "Fork 了一个仓库",
	PublicEvent: "公开了一个仓库",
};

// Collapse same-day, same-repository event bursts. Eight nearly identical
// PushEvent cards are less useful than an honest compact activity summary.
const groupedEvents = new Map<string, { type: string; repository: string; date: string; count: number }>();
for (const event of eventsData ?? []) {
	if (!event.repo?.name || !eventLabels[event.type]) continue;
	const key = event.type + "|" + event.repo.name + "|" + event.created_at.slice(0, 10);
	const existing = groupedEvents.get(key);
	if (existing) existing.count++;
	else groupedEvents.set(key, {
		type: event.type,
		repository: event.repo.name,
		date: event.created_at,
		count: 1,
	});
}
const recentActivity = [...groupedEvents.values()].slice(0, 8).map((event) => ({
	label: eventLabels[event.type] + (event.count > 1 ? " · " + event.count + " 次" : ""),
	repository: event.repository,
	url: "https://github.com/" + event.repository,
	date: formatDate(event.date),
}));

// GitHub's unauthenticated public Events API is a recent sample, not the
// contribution calendar. When its first page is full, dates older than its
// oldest returned event are explicitly unknown rather than rendered as zero.
const eventCounts = new Map<string, number>();
for (const event of eventsData ?? []) {
	const date = new Date(event.created_at);
	if (Number.isNaN(date.getTime())) continue;
	const key = date.toISOString().slice(0, 10);
	eventCounts.set(key, (eventCounts.get(key) ?? 0) + 1);
}

const contributionSource = contributionCalendar ? "contributions" : "events";
const calendarByDate = new Map((contributionCalendar ?? []).map((day) => [day.date, day]));
const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const activityStart = new Date(today);
activityStart.setUTCDate(activityStart.getUTCDate() - (contributionCalendar ? 364 : 90));
activityStart.setUTCDate(activityStart.getUTCDate() - activityStart.getUTCDay());
const activityDayCount = Math.floor((today.getTime() - activityStart.getTime()) / 86_400_000) + 1;
const oldestEventTime =
	eventsData && eventsData.length >= 100
		? Math.min(...eventsData.map((event) => Date.parse(event.created_at)).filter(Number.isFinite))
		: null;
// GitHub Public Events has a maximum 30-day window, even when fewer than
// 100 entries are returned. Days outside that window are not known zeros.
const ageLimit = new Date(today);
ageLimit.setUTCDate(today.getUTCDate() - 29);
const sampleCutoff = Math.max(ageLimit.getTime(), oldestEventTime ?? 0);
const activityDays = Array.from({ length: activityDayCount }, (_, index) => {
	const date = new Date(activityStart);
	date.setUTCDate(activityStart.getUTCDate() + index);
	const key = date.toISOString().slice(0, 10);
	const calendar = calendarByDate.get(key);
	const known = Boolean(calendar) || (!contributionCalendar && eventsData !== null && date.getTime() >= sampleCutoff);
	const count = calendar ? calendar.count : known && !contributionCalendar ? (eventCounts.get(key) ?? 0) : null;
	const level = calendar?.level
		?? (count === null ? "unknown" : count === 0 ? "0" : count === 1 ? "1" : count <= 3 ? "2" : "3");
	return { date: key, count, level };
});
const activityWeeks = Array.from(
	{ length: Math.ceil(activityDays.length / 7) },
	(_, index) => activityDays.slice(index * 7, index * 7 + 7),
);

const profile = {
	...githubProfile,
	avatar: profileData?.avatar_url || githubProfile.avatar,
	url: profileData?.html_url || githubProfile.url,
};
const pageDescription =
	"GitHub 个人开发者主页：公开项目、仓库 Stars、近期公开活动与 Ovio-inspired 动效展示，包含 Minimal、Craft、Retro、Toy 四种交互风格。";
---

<MainGridLayout title="GitHub" description={pageDescription}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div class="w-full min-w-0">
		<GitHubWorldShowcase
			client:visible
			profile={profile}
			stats={stats}
			featuredRepositories={featuredRepositories}
			additionalRepositories={additionalRepositories}
			recentActivity={recentActivity}
			activityWeeks={activityWeeks}
			contributionSource={contributionSource}
			organization={{
				login: "Decohererk",
				name: "Decohererk · DecoTV",
				url: "https://github.com/Decohererk",
				avatar: "https://avatars.githubusercontent.com/u/230862196?v=4",
				repositoryCount: publicOrgRepositories?.length ?? null,
				projectUrl: "https://github.com/Decohererk/DecoTV",
			}}
			filterTabs={filterTabs}
		/>
	</div>
</MainGridLayout>
