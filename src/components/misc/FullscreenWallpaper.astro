---
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

const toArray = (src: string | string[] | undefined): string[] =>
	Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

const srcConfig = config.src;
const desktopSources =
	typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)
		? toArray(srcConfig.desktop)
		: toArray(srcConfig as string | string[]);
const mobileSources =
	typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)
		? toArray(srcConfig.mobile)
		: toArray(srcConfig as string | string[]);

const dayDesktop = desktopSources[0] || mobileSources[0];
const nightDesktop = desktopSources[1] || dayDesktop;
const dayMobile = mobileSources[0] || dayDesktop;
const nightMobile = mobileSources[1] || nightDesktop;
const hasImages = Boolean(dayDesktop || dayMobile);

const position = config.position || "center";
const positionClass =
	position === "top"
		? "object-top"
		: position === "bottom"
			? "object-bottom"
			: "object-center";
const zIndex = config.zIndex ?? -1;
const opacity = config.opacity ?? 0.88;
const blurAmount = config.blur ?? 0;
---

{
	hasImages && (
		<div
			class:list={[
				"fixed inset-0 w-full h-full overflow-hidden pointer-events-none wallpaper-container katelya-wallpaper-canvas",
				className,
			]}
			style={`z-index: ${zIndex}; opacity: var(--wallpaper-opacity, ${opacity}); filter: blur(var(--wallpaper-blur, ${blurAmount}px));`}
			data-fullscreen-wallpaper
			data-katelya-wallpaper
		>
			{dayDesktop && (
				<img
					src={dayDesktop}
					alt=""
					aria-hidden="true"
					class={`katelya-wallpaper-layer katelya-wallpaper--day hidden md:block absolute inset-0 w-full h-full object-cover ${positionClass}`}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			)}
			{nightDesktop && (
				<img
					src={nightDesktop}
					alt=""
					aria-hidden="true"
					class={`katelya-wallpaper-layer katelya-wallpaper--night hidden md:block absolute inset-0 w-full h-full object-cover ${positionClass}`}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			)}
			{dayMobile && (
				<img
					src={dayMobile}
					alt=""
					aria-hidden="true"
					class={`katelya-wallpaper-layer katelya-wallpaper--day block md:hidden absolute inset-0 w-full h-full object-cover ${positionClass}`}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			)}
			{nightMobile && (
				<img
					src={nightMobile}
					alt=""
					aria-hidden="true"
					class={`katelya-wallpaper-layer katelya-wallpaper--night block md:hidden absolute inset-0 w-full h-full object-cover ${positionClass}`}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
			)}

			<script
				is:inline
				define:vars={{
					wallpaperEnabled: config.enable ?? true,
					overlaySwitchable: config.overlay?.switchable ?? true,
				}}
			>
				(function initKatelyaWallpaper() {
					const container = document.currentScript?.parentElement;
					if (!container) return;
					const root = document.documentElement;
					const mode = wallpaperEnabled
						? localStorage.getItem("wallpaperMode") || "banner"
						: "banner";

					if (mode === "overlay") {
						const switches =
							typeof overlaySwitchable === "object"
								? overlaySwitchable
								: {
									opacity: Boolean(overlaySwitchable),
									blur: Boolean(overlaySwitchable),
									cardOpacity: Boolean(overlaySwitchable),
								};
						const storedOpacity = switches.opacity
							? localStorage.getItem("overlayOpacity")
							: null;
						const storedBlur = switches.blur
							? localStorage.getItem("overlayBlur")
							: null;
						const storedCardOpacity = switches.cardOpacity
							? localStorage.getItem("overlayCardOpacity")
							: null;

						if (storedOpacity) {
							container.style.setProperty("--wallpaper-opacity", storedOpacity);
						}
						if (storedBlur) {
							container.style.setProperty("--wallpaper-blur", `${storedBlur}px`);
						}
						if (storedCardOpacity) {
							root.style.setProperty(
								"--card-transparent-opacity",
								storedCardOpacity,
							);
						}
						container.style.display = "block";
					} else {
						root.style.removeProperty("--card-transparent-opacity");
						container.style.display = "none";
					}
				})();
			</script>
		</div>
	)
}
