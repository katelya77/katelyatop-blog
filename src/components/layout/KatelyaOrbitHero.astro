---
import TypewriterText from "@components/atoms/typewriter-text/TypewriterText.astro";

interface TypewriterConfig {
	enable?: boolean;
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
}

interface Props {
	title?: string;
	subtitle?: string | string[];
	typewriterConfig?: TypewriterConfig;
	active?: boolean;
}

const { title, subtitle, typewriterConfig, active = false } = Astro.props;

const orbitItems = [
	{
		label: "技术折腾",
		detail: "Code & Deploy",
		href: "/archive/",
		icon: "⌁",
	},
	{
		label: "开源项目",
		detail: "Projects",
		href: "/projects/",
		icon: "✦",
	},
	{
		label: "成长时间线",
		detail: "Timeline",
		href: "/timeline/",
		icon: "◌",
	},
	{
		label: "关于我",
		detail: "About",
		href: "/about/",
		icon: "✧",
	},
];
---

<section
	class:list={["katelya-orbit-hero", { "is-home-active": active }]}
	aria-labelledby="katelya-hero-title"
	aria-hidden={active ? "false" : "true"}
	data-katelya-orbit
>
	<div class="katelya-paint-aura" aria-hidden="true">
		<span class="katelya-aura-ring katelya-aura-ring--outer"></span>
		<span class="katelya-aura-ring katelya-aura-ring--inner"></span>
		<span class="katelya-gold-fleck katelya-gold-fleck--one"></span>
		<span class="katelya-gold-fleck katelya-gold-fleck--two"></span>
		<span class="katelya-gold-fleck katelya-gold-fleck--three"></span>
	</div>

	<div class="katelya-orbit-stage" aria-hidden="true">
		{orbitItems.map((item, index) => (
			<a
				class={`katelya-orbit-card katelya-orbit-card--${index + 1}`}
				href={item.href}
				tabindex="-1"
				aria-hidden="true"
			>
				<span class="katelya-orbit-card__icon">{item.icon}</span>
				<span class="katelya-orbit-card__copy">
					<strong>{item.label}</strong>
					<small>{item.detail}</small>
				</span>
			</a>
		))}
	</div>

	<div class="katelya-hero-copy">
		<p class="katelya-hero-eyebrow">PERSONAL DIGITAL GARDEN · 2026</p>
		{title && (
			<h1 id="katelya-hero-title" class="katelya-hero-title">
				<span>{title}</span>
			</h1>
		)}
		{subtitle && (
			<p class="katelya-hero-subtitle">
				<span class="katelya-hero-subtitle__line">
					{typewriterConfig?.enable && Array.isArray(subtitle) ? (
						<TypewriterText
							text={subtitle}
							speed={typewriterConfig.speed}
							deleteSpeed={typewriterConfig.deleteSpeed}
							pauseTime={typewriterConfig.pauseTime}
						/>
					) : Array.isArray(subtitle) ? (
						subtitle[0]
					) : (
						subtitle
					)}
				</span>
			</p>
		)}

		<nav class="katelya-hero-links" aria-label="首页快速入口">
			{orbitItems.map((item) => (
				<a href={item.href}>
					<span aria-hidden="true">{item.icon}</span>
					{item.label}
				</a>
			))}
		</nav>
	</div>
</section>

<script is:inline data-swup-ignore-script>
	(function initKatelyaOrbitHero() {
		if (window.__katelyaOrbitCleanup) {
			window.__katelyaOrbitCleanup();
			window.__katelyaOrbitCleanup = null;
		}

		var hero = document.querySelector("[data-katelya-orbit]");
		if (!hero) return;

		var animationFrame = 0;
		var syncFrame = 0;
		var targetX = 0;
		var targetY = 0;

		function getHomeState() {
			var data = document.getElementById("page-overlay-data");
			if (data && data.dataset.isHome) {
				return data.dataset.isHome === "true";
			}
			return window.location.pathname === "/";
		}

		function syncKatelyaHomeState(isHomePage) {
			var shell = document.querySelector(".katelya-main-shell");
			var navbar = document.getElementById("navbar");

			document.body.classList.toggle("katelya-home-page", isHomePage);
			hero.classList.toggle("is-home-active", isHomePage);
			hero.setAttribute("aria-hidden", isHomePage ? "false" : "true");
			if (shell) shell.classList.toggle("is-home-layout", isHomePage);
			if (navbar) {
				navbar.dataset.isHome = isHomePage ? "true" : "false";
				navbar.classList.toggle(
					"scrolled",
					!isHomePage || window.scrollY > 28,
				);
			}

			var legacyTitle = document.querySelector(".banner-text-overlay");
			if (legacyTitle) legacyTitle.classList.add("hidden");
		}

		function queueHomeStateSync() {
			if (syncFrame) return;
			syncFrame = requestAnimationFrame(function () {
				syncFrame = 0;
				syncKatelyaHomeState(getHomeState());
			});
		}

		function renderTilt() {
			animationFrame = 0;
			hero.style.setProperty("--orbit-ry", targetX.toFixed(2) + "deg");
			hero.style.setProperty("--orbit-rx", targetY.toFixed(2) + "deg");
		}

		function queueTiltRender() {
			if (!animationFrame) animationFrame = requestAnimationFrame(renderTilt);
		}

		function onPointerMove(event) {
			if (!hero.classList.contains("is-home-active")) return;
			var rect = hero.getBoundingClientRect();
			var x = (event.clientX - rect.left) / rect.width - 0.5;
			var y = (event.clientY - rect.top) / rect.height - 0.5;
			targetX = x * 5;
			targetY = y * -3.5;
			queueTiltRender();
		}

		function onPointerLeave() {
			targetX = 0;
			targetY = 0;
			queueTiltRender();
		}

		var observer = new MutationObserver(queueHomeStateSync);
		observer.observe(document.body, { childList: true, subtree: true });
		document.addEventListener("swup:page:view", queueHomeStateSync);
		window.addEventListener("popstate", queueHomeStateSync);
		queueHomeStateSync();

		var reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		if (!reducedMotion) {
			hero.addEventListener("pointermove", onPointerMove, { passive: true });
			hero.addEventListener("pointerleave", onPointerLeave, { passive: true });
		}

		window.__katelyaOrbitCleanup = function () {
			if (animationFrame) cancelAnimationFrame(animationFrame);
			if (syncFrame) cancelAnimationFrame(syncFrame);
			observer.disconnect();
			document.removeEventListener("swup:page:view", queueHomeStateSync);
			window.removeEventListener("popstate", queueHomeStateSync);
			hero.removeEventListener("pointermove", onPointerMove);
			hero.removeEventListener("pointerleave", onPointerLeave);
		};
	})();
</script>

<style>
	.katelya-orbit-hero {
		position: absolute;
		inset: 0 0 auto;
		z-index: 24;
		display: grid;
		place-items: center;
		width: 100%;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		perspective: 1200px;
		transform: translateY(-0.6rem);
		transition:
			opacity 220ms ease,
			visibility 0s linear 220ms,
			transform 260ms ease;
	}

	.katelya-orbit-hero.is-home-active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
		transition-delay: 0s;
	}

	.katelya-paint-aura,
	.katelya-orbit-stage {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.katelya-paint-aura {
		overflow: hidden;
	}

	.katelya-aura-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		border: 1px solid color-mix(in srgb, var(--katelya-gold) 44%, transparent);
		border-radius: 50%;
		transform: translate(-50%, -50%) rotate(-8deg);
	}

	.katelya-aura-ring--outer {
		width: min(76vw, 72rem);
		height: min(36vw, 32rem);
	}

	.katelya-aura-ring--inner {
		width: min(54vw, 50rem);
		height: min(25vw, 22rem);
		transform: translate(-50%, -50%) rotate(11deg);
	}

	.katelya-gold-fleck {
		position: absolute;
		width: 0.44rem;
		height: 0.44rem;
		border-radius: 50%;
		background: var(--katelya-gold);
		box-shadow: 0 0 1.1rem color-mix(in srgb, var(--katelya-gold) 68%, transparent);
	}

	.katelya-gold-fleck--one {
		top: 18%;
		left: 21%;
	}

	.katelya-gold-fleck--two {
		top: 30%;
		right: 18%;
	}

	.katelya-gold-fleck--three {
		bottom: 25%;
		right: 25%;
	}

	.katelya-orbit-stage {
		left: 50%;
		width: min(82vw, 78rem);
		transform: translateX(-50%) rotateX(var(--orbit-rx, 0deg))
			rotateY(var(--orbit-ry, 0deg));
		transform-style: preserve-3d;
		transition: transform 120ms ease-out;
	}

	.katelya-orbit-card {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 10.5rem;
		padding: 0.72rem 0.9rem;
		color: var(--katelya-text);
		text-decoration: none;
		border-radius: 1rem 0.78rem 1.08rem 0.82rem;
		backdrop-filter: blur(12px);
		transform-style: preserve-3d;
	}

	.katelya-orbit-card--1 {
		top: 8%;
		left: 4%;
		transform: translateZ(46px) rotate(-4deg);
	}

	.katelya-orbit-card--2 {
		top: 4%;
		right: 3%;
		transform: translateZ(70px) rotate(3deg);
	}

	.katelya-orbit-card--3 {
		bottom: 2%;
		left: 8%;
		transform: translateZ(24px) rotate(2deg);
	}

	.katelya-orbit-card--4 {
		right: 7%;
		bottom: 4%;
		transform: translateZ(38px) rotate(-3deg);
	}

	.katelya-orbit-card__icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		color: var(--primary);
		border-radius: 50%;
		background: color-mix(in srgb, var(--katelya-surface-soft) 84%, transparent);
	}

	.katelya-orbit-card__copy {
		display: grid;
		gap: 0.05rem;
	}

	.katelya-orbit-card__copy strong {
		font-size: 0.92rem;
	}

	.katelya-orbit-card__copy small {
		font-size: 0.63rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.56;
	}

	.katelya-hero-copy {
		position: relative;
		z-index: 3;
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.katelya-hero-eyebrow {
		margin: 0 0 1.1rem;
		color: color-mix(in srgb, var(--katelya-gold) 78%, var(--katelya-text));
		font-size: clamp(0.65rem, 0.9vw, 0.82rem);
		font-weight: 700;
		letter-spacing: 0.28em;
	}

	.katelya-hero-title {
		margin: 0;
		color: var(--katelya-cream);
		font-family: var(--font-cjk), var(--font-body), serif;
		font-weight: 760;
		text-wrap: balance;
	}

	.katelya-hero-subtitle {
		min-height: 2rem;
		margin: 1.15rem 0 0;
		color: color-mix(in srgb, var(--katelya-cream) 88%, var(--katelya-text));
		font-weight: 580;
		text-shadow: 0 2px 14px rgba(10, 38, 40, 0.35);
	}

	.katelya-hero-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 1.45rem;
	}

	.katelya-hero-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem 0.78rem;
		color: var(--katelya-text);
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
		border: 1px solid var(--katelya-border-bright);
		border-radius: 999px;
		background: color-mix(in srgb, var(--katelya-surface) 84%, transparent);
		box-shadow: 0 8px 24px rgba(18, 58, 57, 0.16);
		backdrop-filter: blur(10px);
	}

	.katelya-hero-links a:hover,
	.katelya-hero-links a:focus-visible {
		color: var(--primary);
		background: var(--katelya-surface-strong);
	}

	@media (max-width: 767px) {
		.katelya-hero-eyebrow {
			letter-spacing: 0.18em;
		}

		.katelya-hero-subtitle {
			width: min(88vw, 30rem);
			font-size: 0.94rem;
		}

		.katelya-hero-links {
			width: min(90vw, 30rem);
		}
	}
</style>
