---
import "../../styles/katelya-hero-depth.css";
---

<div class="impasto-backdrop" aria-hidden="true">
	<canvas data-impasto-canvas></canvas>
	<div class="impasto-static-fallback"></div>
</div>

<script>
	type RendererModule = {
		initImpastoRenderer: () => void;
	};

	type ArtLayerWindow = Window & {
		__katelyaRendererPromise?: Promise<RendererModule>;
		__katelyaArtLayersFrame?: number;
		__katelyaArtPageLoadBound?: boolean;
		__katelyaDepthIdleId?: number;
		__katelyaDepthTimerId?: number;
	};

	const artWindow = window as ArtLayerWindow;

	function loadRenderer(): Promise<RendererModule> {
		artWindow.__katelyaRendererPromise ??= import(
			"../../scripts/impasto-renderer"
		).then((impasto) => ({
			initImpastoRenderer: impasto.initImpastoRenderer,
		}));
		return artWindow.__katelyaRendererPromise;
	}

	function scheduleHeroDepth() {
		if (artWindow.__katelyaDepthIdleId && "cancelIdleCallback" in window) {
			window.cancelIdleCallback(artWindow.__katelyaDepthIdleId);
		}
		if (artWindow.__katelyaDepthTimerId) {
			window.clearTimeout(artWindow.__katelyaDepthTimerId);
		}

		const initialize = () => {
			artWindow.__katelyaDepthIdleId = undefined;
			artWindow.__katelyaDepthTimerId = undefined;
			void import("../../scripts/hero-depth").then(({ initKatelyaHeroDepth }) => {
				initKatelyaHeroDepth();
			});
		};

		if ("requestIdleCallback" in window) {
			artWindow.__katelyaDepthIdleId = window.requestIdleCallback(initialize, {
				timeout: 650,
			});
			return;
		}

		artWindow.__katelyaDepthTimerId = window.setTimeout(initialize, 180);
	}

	function initializeKatelyaArtLayers() {
		if (artWindow.__katelyaArtLayersFrame) {
			cancelAnimationFrame(artWindow.__katelyaArtLayersFrame);
		}

		artWindow.__katelyaArtLayersFrame = requestAnimationFrame(() => {
			artWindow.__katelyaArtLayersFrame = 0;
			void loadRenderer().then(({ initImpastoRenderer }) => {
				initImpastoRenderer();
				scheduleHeroDepth();
			});
		});
	}

	initializeKatelyaArtLayers();
	if (!artWindow.__katelyaArtPageLoadBound) {
		artWindow.__katelyaArtPageLoadBound = true;
		document.addEventListener("astro:page-load", initializeKatelyaArtLayers);
	}
</script>
