---
import "../../styles/katelya-hero-depth.css";
---

<div class="impasto-backdrop" aria-hidden="true">
	<canvas data-impasto-canvas></canvas>
	<div class="impasto-static-fallback"></div>
</div>

<script>
	import { initKatelyaHeroDepth } from "../../scripts/hero-depth";
	import { initImpastoRenderer } from "../../scripts/impasto-renderer";

	function initializeKatelyaArtLayers() {
		initImpastoRenderer();
		initKatelyaHeroDepth();
	}

	initializeKatelyaArtLayers();
	document.addEventListener("astro:page-load", initializeKatelyaArtLayers);
</script>
