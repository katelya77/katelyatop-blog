---
import { Icon } from "astro-icon/components";

import { navBarConfig, siteConfig } from "../../../config";
import { LinkPresets } from "../../../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../../../types/config";
import { url } from "../../../utils/url-utils";
import ThemeSwitch from "../../control/ThemeSwitch.svelte";
import SettingsPanel from "../../features/settings/SettingsPanel.svelte";
import MobileTOC from "../../features/toc/MobileTOC.svelte";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";
import Search from "./Search.svelte";

const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

const featurePageUrlMap: Record<string, string> = {
	"/anime/": "anime",
	"/diary/": "diary",
	"/friends/": "friends",
	"/projects/": "projects",
	"/skills/": "skills",
	"/timeline/": "timeline",
	"/albums/": "albums",
	"/devices/": "devices",
};

function isFeaturePageDisabled(linkUrl: string): boolean {
	const key = featurePageUrlMap[linkUrl];
	return Boolean(
		key &&
			!siteConfig.featurePages[key as keyof typeof siteConfig.featurePages],
	);
}

function filterLinksByFeaturePages(
	items: (NavBarLink | LinkPreset)[],
): NavBarLink[] {
	return items
		.map((item): NavBarLink | null => {
			const resolved =
				typeof item === "number" ? LinkPresets[item] : (item as NavBarLink);
			if (isFeaturePageDisabled(resolved.url)) return null;
			if (!resolved.children) return resolved;
			const children = filterLinksByFeaturePages(resolved.children);
			return children.length > 0 ? { ...resolved, children } : null;
		})
		.filter((item): item is NavBarLink => item !== null);
}

const links = filterLinksByFeaturePages(navBarConfig.links);
const rawIcon = siteConfig.navbarTitle?.icon;
const iconSrc = rawIcon?.match(/^(http|https|\/\/)/)
	? rawIcon
	: rawIcon
		? url(rawIcon)
		: "";
---

<nav
	id="navbar"
	class="katelya-gallery-header katelya-navbar-shell z-50"
	data-transparent-mode={navbarTransparentMode}
	data-is-home={isHomePage}
	aria-label="主导航栏"
>
	<a href={url("/")} class="katelya-navbar-brand" aria-label="返回首页">
		{iconSrc ? (
			<img src={iconSrc} alt="" class="katelya-navbar-logo" loading="eager" />
		) : (
			<Icon name="material-symbols:palette-outline" class="text-[1.5rem]" />
		)}
		<span>{siteConfig.navbarTitle?.text || siteConfig.title}</span>
	</a>

	<div
		id="navbar-links-container"
		class="katelya-navbar-links"
		aria-label="主导航"
	>
		{links.map((link) => <DropdownMenu link={link} />)}
	</div>

	<div class="katelya-navbar-tools">
		<button
			aria-label="显示设置"
			class="btn-plain scale-animation rounded-lg h-10 w-10 active:scale-90"
			id="display-settings-switch"
			data-katelya-overlay-trigger="settings"
			popovertarget="display-setting"
			aria-haspopup="dialog"
			aria-controls="display-setting"
		>
			<Icon name="material-symbols:palette-outline" class="text-[1.2rem]" />
		</button>
		<ThemeSwitch client:only="svelte" />
		<div id="search-container" data-katelya-overlay-trigger="search">
			<Search client:only="svelte" />
		</div>
		{
			siteConfig.toc.enable && siteConfig.toc.mobileTop && (
				<MobileTOC client:only="svelte" />
			)
		}
		<button
			aria-label="导航菜单"
			name="Nav Menu"
			class="btn-plain scale-animation rounded-lg w-10 h-10 active:scale-90 katelya-menu-switch"
			id="nav-menu-switch"
			data-katelya-overlay-trigger="menu"
			popovertarget="nav-menu-panel"
			aria-haspopup="menu"
			aria-controls="nav-menu-panel"
		>
			<Icon name="material-symbols:menu-rounded" class="text-[1.25rem]" />
		</button>
	</div>
</nav>

<NavMenuPanel links={links} />
<SettingsPanel client:only="svelte" />

<script>
	type KatelyaHeaderWindow = Window & {
		__katelyaHeaderCleanup?: () => void;
	};

	function initKatelyaGalleryHeader() {
		const katelyaWindow = window as KatelyaHeaderWindow;
		katelyaWindow.__katelyaHeaderCleanup?.();

		const navbar = document.getElementById("navbar");

		let ticking = false;
		const updateScrollState = () => {
			ticking = false;
			if (!navbar) return;
			const isHome = navbar.dataset.isHome === "true";
			navbar.classList.toggle("scrolled", !isHome || window.scrollY > 28);
		};
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(updateScrollState);
		};

		window.addEventListener("scroll", onScroll, { passive: true });
		updateScrollState();

		katelyaWindow.__katelyaHeaderCleanup = () => {
			window.removeEventListener("scroll", onScroll);
		};
	}

	initKatelyaGalleryHeader();
</script>

<script is:inline>
	window.loadPagefind = async function () {
		if (window.pagefind) return;
		try {
			const scriptUrl = new URL("pagefind/pagefind.js", window.location.origin).href;
			const response = await fetch(scriptUrl, { method: "HEAD" });
			if (!response.ok) throw new Error(`Pagefind script not found: ${response.status}`);
			const pagefind = await import(scriptUrl);
			await pagefind.options({ excerptLength: 20 });
			window.pagefind = pagefind;
			document.dispatchEvent(new CustomEvent("pagefindready"));
		} catch (error) {
			console.error("Failed to load Pagefind:", error);
			window.pagefind = {
				search: () => Promise.resolve({ results: [] }),
				options: () => Promise.resolve(),
			};
			document.dispatchEvent(new CustomEvent("pagefindloaderror"));
		}
	};
</script>
