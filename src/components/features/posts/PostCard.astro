---
import { render } from "astro:content";
import { getPostHomeContent } from "@utils/post-card-content";
import { Icon } from "astro-icon/components";

import { getFileDirFromPath, getPostUrl, getTagUrl } from "@/utils/url-utils";

import { siteConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import Image from "../../atoms/Image/Image.astro";
import PostMetadata from "./PostMeta.astro";
import type { PostCardProps } from "./types";

const { entry, style }: PostCardProps = Astro.props as PostCardProps;
const className = Astro.props.class;
const {
	title,
	published,
	updated,
	tags,
	category,
	image,
	description,
	hideHomeContent,
	pinned,
	encrypted,
	password,
} = entry.data;

const postUrl = getPostUrl(entry);
const hasCover = Boolean(image);
const coverWidth = "28%";
const { remarkPluginFrontmatter } = await render(entry);
const homeContent = getPostHomeContent(
	{ description, hideHomeContent, password },
	remarkPluginFrontmatter.excerpt,
);
---

<article
	class:list={[
		"katelya-post-card card-base flex flex-col-reverse md:flex-col w-full rounded-(--radius-large) overflow-hidden relative",
		className,
	]}
	style={style}
>
	<div
		class:list={[
			"katelya-post-card-content pl-6 md:pl-9 pr-6 pt-6 md:pt-7 pb-7 relative",
			{
				"w-full md:pr-18": !hasCover,
				"w-full md:w-[calc(100%-var(--coverWidth)-0.75rem)] md:pr-4":
					hasCover,
			},
		]}
	>
		<a
			href={postUrl}
			class="katelya-post-card-title transition group w-full block font-bold mb-3 text-3xl text-90 hover:text-(--primary) active:text-(--title-active) before:w-1 before:h-5 before:rounded-md before:bg-(--primary) before:absolute before:top-8.75 before:left-4.5 before:hidden md:before:block"
		>
			{
				pinned && (
					<Icon
						name="mdi:pin"
						class="inline text-(--primary) text-2xl mr-2 -translate-y-0.5"
					/>
				)
			}
			{title}
			{
				encrypted && password && (
					<Icon
						name="material-symbols:lock-outline"
						class="inline text-2xl align-middle -translate-y-px ml-2"
					/>
				)
			}
		</a>

		<PostMetadata
			published={published}
			updated={updated}
			tags={tags}
			category={category || ""}
			hideTagsForMobile={true}
			hideUpdateDate={true}
			className="mb-4"
			showOnlyBasicMeta={true}
			words={remarkPluginFrontmatter.words}
			showWordCount={true}
		/>

		<div
			class:list={[
				"transition text-75 mb-3.5 pr-2",
				{ "line-clamp-2 md:line-clamp-1": !description },
			]}
		>
			{homeContent}
		</div>

		<div class="flex flex-wrap gap-2 mt-2">
			{
				tags && tags.length > 0 ? (
					tags.map((tag) => (
						<a
							href={getTagUrl(tag)}
							class:list={[
								siteConfig.tagStyle?.useNewStyle
									? "link-lg transition text-50 text-xs font-medium px-2 py-1 rounded-lg hover:text-(--primary) active:text-(--primary) group/tag whitespace-nowrap"
									: "btn-regular h-6 text-xs px-2 rounded-lg",
							]}
							aria-label={`查看标签 ${tag.trim()}`}
						>
							<span class="transition-transform group-hover/tag:translate-x-0.5">
								# {tag.trim()}
							</span>
						</a>
					))
				) : (
					<span class="text-xs text-50">{i18n(I18nKey.noTags)}</span>
				)
			}
		</div>

		{
			!hasCover && (
				<a
					href={postUrl}
					aria-label={`阅读全文：${title}`}
					class="katelya-post-card-arrow"
				>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			)
		}
	</div>

	{
		hasCover && image && (
			<a
				href={postUrl}
				aria-label={`阅读全文：${title}`}
				class="katelya-post-cover group max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0 md:w-(--coverWidth) relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95"
			>
				<div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/20 group-active:bg-black/40 transition" />
				<div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
					<Icon
						name="material-symbols:arrow-forward-rounded"
						class="transition opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 text-white text-4xl"
					/>
				</div>
				<Image
					src={image}
					basePath={getFileDirFromPath(entry.filePath || "")}
					alt={`文章封面：${title}`}
					class="w-full h-full"
					widths={[200, 400, 800]}
					sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
				/>
			</a>
		)
	}
</article>
<div class="transition border-t border-dashed mx-6 border-black/10 dark:border-white/15 last:border-t-0 md:hidden" />

<style define:vars={{ coverWidth }}></style>
