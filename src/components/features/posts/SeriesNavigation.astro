---
import { Icon } from "astro-icon/components";

export interface SeriesItem {
	title: string;
	url: string;
	order: number;
}

interface Props {
	series: string;
	homeUrl: string;
	currentOrder: number;
	items: SeriesItem[];
	position?: "top" | "bottom";
}

const {
	series,
	homeUrl,
	currentOrder,
	items,
	position = "top",
} = Astro.props;
const currentIndex = items.findIndex((item) => item.order === currentOrder);
const previous = currentIndex > 0 ? items[currentIndex - 1] : undefined;
const next =
	currentIndex >= 0 && currentIndex < items.length - 1
		? items[currentIndex + 1]
		: undefined;
const progress =
	items.length > 0 && currentIndex >= 0
		? Math.round(((currentIndex + 1) / items.length) * 100)
		: 0;
---

<nav
	data-series-navigation
	data-series-position={position}
	aria-label={`${series}系列导航`}
	class:list={[
		"card-base border border-black/5 dark:border-white/8 rounded-2xl px-4 py-4 md:px-5",
		position === "top" ? "mb-6" : "mb-4 mt-2",
	]}
>
	<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
		<a
			href={homeUrl}
			class="group min-w-0 flex items-center gap-3 no-underline active:scale-[0.99] transition"
		>
			<span
				class="h-10 w-10 shrink-0 rounded-xl bg-(--primary)/12 text-(--primary) flex items-center justify-center"
			>
				<Icon name="material-symbols:school-outline-rounded" class="text-xl" />
			</span>
			<span class="min-w-0">
				<span class="block text-xs text-black/45 dark:text-white/45 mb-0.5">
					专题系列
				</span>
				<span
					class="block font-bold text-sm md:text-base text-black/80 dark:text-white/85 truncate group-hover:text-(--primary) transition"
				>
					{series}
				</span>
			</span>
		</a>

		<div class="flex items-center justify-between gap-3 md:justify-end shrink-0">
			<span
				class="text-xs font-medium px-2.5 py-1 rounded-full bg-black/5 dark:bg-white/8 text-black/50 dark:text-white/55"
			>
				{Math.max(currentIndex + 1, 1)} / {items.length}
			</span>
			<a
				href={homeUrl}
				class="text-sm font-medium text-(--primary) hover:opacity-75 transition no-underline"
			>
				返回总览
			</a>
		</div>
	</div>

	<div class="mt-3 h-1.5 rounded-full bg-black/5 dark:bg-white/8 overflow-hidden">
		<div
			class="h-full rounded-full bg-(--primary) transition-[width] duration-300"
			style={`width: ${progress}%`}
		></div>
	</div>

	{
		(previous || next) && (
			<div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2">
				{previous ? (
					<a
						href={previous.url}
						class="btn-card rounded-xl px-3.5 py-3 min-w-0 flex items-center gap-2.5 no-underline active:scale-[0.99]"
					>
						<Icon
							name="material-symbols:chevron-left-rounded"
							class="text-xl text-(--primary) shrink-0"
						/>
						<span class="min-w-0">
							<span class="block text-[0.68rem] text-black/40 dark:text-white/40">
								上一篇
							</span>
							<span class="block text-sm font-semibold text-black/70 dark:text-white/75 truncate">
								{previous.title}
							</span>
						</span>
					</a>
				) : (
					<div class="hidden sm:block" aria-hidden="true" />
				)}
				{next && (
					<a
						href={next.url}
						class="btn-card rounded-xl px-3.5 py-3 min-w-0 flex items-center justify-between gap-2.5 no-underline active:scale-[0.99]"
					>
						<span class="min-w-0 text-right ml-auto">
							<span class="block text-[0.68rem] text-black/40 dark:text-white/40">
								下一篇
							</span>
							<span class="block text-sm font-semibold text-black/70 dark:text-white/75 truncate">
								{next.title}
							</span>
						</span>
						<Icon
							name="material-symbols:chevron-right-rounded"
							class="text-xl text-(--primary) shrink-0"
						/>
					</a>
				)}
			</div>
		)
	}
</nav>
