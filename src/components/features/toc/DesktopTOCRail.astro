---
import type { MarkdownHeading } from "astro";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import SidebarTOC from "./SidebarTOC.astro";

interface Props {
	headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const tocLabel = i18n(I18nKey.tableOfContents);
---

<aside
	id="desktop-toc-rail"
	class="desktop-toc-rail"
	aria-label={tocLabel}
>
	<div class="desktop-toc-surface">
		<div class="desktop-toc-heading">
			<span class="desktop-toc-heading-mark" aria-hidden="true"></span>
			<span class="desktop-toc-heading-text">{tocLabel}</span>
			<span class="desktop-toc-heading-glyph" aria-hidden="true">≡</span>
		</div>

		<div class="desktop-toc-scroll">
			<SidebarTOC headings={headings} class="desktop-toc-content" />
		</div>
	</div>
</aside>

<style>
	.desktop-toc-rail {
		--desktop-toc-compact-width: min(var(--toc-width), 4.75rem);
		--desktop-toc-expanded-width: 15.5rem;
		position: relative;
		z-index: 18;
		width: var(--desktop-toc-compact-width);
		max-width: 100%;
		margin-inline-start: auto;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.18s ease;
	}

	.desktop-toc-rail:has(table-of-contents[data-loaded="true"]) {
		opacity: 1;
		pointer-events: auto;
	}

	.desktop-toc-surface {
		width: var(--desktop-toc-compact-width);
		max-height: calc(100dvh - 7rem);
		margin-inline-start: auto;
		overflow: hidden;
		border: 1px solid
			color-mix(in oklab, var(--line-color) 82%, transparent);
		border-radius: 1.25rem;
		background: color-mix(
			in oklab,
			var(--card-bg-transparent) 92%,
			transparent
		);
		backdrop-filter: blur(14px) saturate(1.06);
		-webkit-backdrop-filter: blur(14px) saturate(1.06);
		box-shadow:
			0 14px 36px rgba(20, 31, 29, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.3);
		transform-origin: right top;
		transition:
			width 0.22s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.22s ease;
	}

	.desktop-toc-heading {
		display: grid;
		grid-template-columns: 0.2rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		min-height: 3rem;
		padding: 0.7rem 0.75rem;
		border-bottom: 1px solid
			color-mix(in oklab, var(--line-divider) 80%, transparent);
		color: color-mix(in oklab, var(--content-meta) 84%, var(--primary));
	}

	.desktop-toc-heading-mark {
		width: 0.2rem;
		height: 1rem;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 0.18rem
			color-mix(in oklab, var(--primary) 10%, transparent);
	}

	.desktop-toc-heading-text {
		min-width: 0;
		max-width: 0;
		overflow: hidden;
		opacity: 0;
		white-space: nowrap;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		transition:
			max-width 0.18s ease,
			opacity 0.14s ease;
	}

	.desktop-toc-heading-glyph {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 0.65rem;
		background: color-mix(in oklab, var(--toc-badge-bg) 76%, transparent);
		color: var(--btn-content);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1;
	}

	.desktop-toc-scroll {
		max-height: calc(100dvh - 10rem);
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: color-mix(in oklab, var(--line-color) 70%, transparent)
			transparent;
		padding: 0.42rem;
	}

	.desktop-toc-scroll::-webkit-scrollbar {
		width: 3px;
	}

	.desktop-toc-scroll::-webkit-scrollbar-track {
		background: transparent;
	}

	.desktop-toc-scroll::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: color-mix(in oklab, var(--line-color) 70%, transparent);
	}

	:global(.desktop-toc-rail .desktop-toc-content) {
		display: block;
		width: 100%;
		overflow: visible;
	}

	:global(.desktop-toc-rail .sidebar-toc-item) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		min-height: 2.25rem;
		padding: 0.42rem 0.5rem;
		border-radius: 0.8rem;
		text-decoration: none;
		color: color-mix(in oklab, var(--content-meta) 90%, transparent);
		transition:
			background-color 0.14s ease,
			color 0.14s ease,
			transform 0.14s ease;
	}

	:global(.desktop-toc-rail .sidebar-toc-item:hover) {
		background: color-mix(in oklab, var(--toc-btn-hover) 82%, transparent);
		color: color-mix(in oklab, var(--content-meta) 72%, var(--primary));
	}

	:global(.desktop-toc-rail .sidebar-toc-item:focus-visible) {
		outline: 2px solid color-mix(in oklab, var(--primary) 50%, transparent);
		outline-offset: 1px;
	}

	:global(.desktop-toc-rail .sidebar-toc-item.visible) {
		background: color-mix(in oklab, var(--toc-btn-active) 88%, transparent);
		color: var(--primary);
	}

	:global(.desktop-toc-rail .sidebar-toc-marker) {
		margin-inline-start: 0 !important;
		transition:
			margin 0.18s ease,
			transform 0.18s ease;
	}

	:global(.desktop-toc-rail .sidebar-toc-item.visible .sidebar-toc-marker) {
		transform: scale(1.06);
	}

	:global(.desktop-toc-rail .sidebar-toc-label) {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		min-width: 0;
		max-width: 0;
		overflow: hidden;
		overflow-wrap: anywhere;
		word-break: normal;
		line-height: 1.35;
		opacity: 0;
		font-size: 0.82rem;
		transition:
			max-width 0.18s ease,
			opacity 0.14s ease;
	}

	:global(.desktop-toc-rail .sidebar-toc-active-indicator) {
		display: none;
	}

	.desktop-toc-rail:not(:hover):not(:focus-within)
		:global(.sidebar-toc-item) {
		justify-content: center;
	}

	.desktop-toc-rail:hover .desktop-toc-surface,
	.desktop-toc-rail:focus-within .desktop-toc-surface {
		width: min(var(--desktop-toc-expanded-width), calc(100vw - 1.5rem));
		transform: translateX(
			calc(
				var(--desktop-toc-compact-width) -
					min(var(--desktop-toc-expanded-width), calc(100vw - 1.5rem))
			)
		);
		box-shadow:
			0 18px 48px rgba(20, 31, 29, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.36);
	}

	.desktop-toc-rail:hover .desktop-toc-heading-text,
	.desktop-toc-rail:focus-within .desktop-toc-heading-text {
		max-width: 10rem;
		opacity: 1;
	}

	.desktop-toc-rail:hover :global(.sidebar-toc-label),
	.desktop-toc-rail:focus-within :global(.sidebar-toc-label) {
		max-width: 11.8rem;
		opacity: 1;
	}

	.desktop-toc-rail:hover :global(.sidebar-toc-marker[data-depth="1"]),
	.desktop-toc-rail:focus-within :global(.sidebar-toc-marker[data-depth="1"]) {
		margin-inline-start: 0.72rem !important;
	}

	.desktop-toc-rail:hover :global(.sidebar-toc-marker[data-depth="2"]),
	.desktop-toc-rail:focus-within :global(.sidebar-toc-marker[data-depth="2"]) {
		margin-inline-start: 1.32rem !important;
	}

	@media (min-width: 1880px) {
		.desktop-toc-rail {
			width: clamp(12rem, var(--toc-width), 16rem);
		}

		.desktop-toc-surface,
		.desktop-toc-rail:hover .desktop-toc-surface,
		.desktop-toc-rail:focus-within .desktop-toc-surface {
			width: 100%;
			transform: none;
		}

		.desktop-toc-heading-text,
		.desktop-toc-rail:hover .desktop-toc-heading-text,
		.desktop-toc-rail:focus-within .desktop-toc-heading-text {
			max-width: 10rem;
			opacity: 1;
		}

		:global(.desktop-toc-rail .sidebar-toc-label),
		.desktop-toc-rail:hover :global(.sidebar-toc-label),
		.desktop-toc-rail:focus-within :global(.sidebar-toc-label) {
			max-width: 11rem;
			opacity: 1;
		}

		.desktop-toc-rail:not(:hover):not(:focus-within)
			:global(.sidebar-toc-item) {
			justify-content: flex-start;
		}

		:global(.desktop-toc-rail .sidebar-toc-marker[data-depth="1"]) {
			margin-inline-start: 0.72rem !important;
		}

		:global(.desktop-toc-rail .sidebar-toc-marker[data-depth="2"]) {
			margin-inline-start: 1.32rem !important;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.desktop-toc-rail,
		.desktop-toc-surface,
		.desktop-toc-heading-text,
		:global(.desktop-toc-rail .sidebar-toc-item),
		:global(.desktop-toc-rail .sidebar-toc-marker),
		:global(.desktop-toc-rail .sidebar-toc-label) {
			transition: none !important;
		}
	}
</style>
