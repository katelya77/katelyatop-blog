---
import { Font } from "astro:assets";
import { PageProgressBar } from "@components/control/PageProgressBar";
import Pio from "@components/features/pio/Pio.astro";
import ImpastoBackdrop from "@components/layout/ImpastoBackdrop.astro";
import ConfigCarrier from "@components/misc/ConfigCarrier.astro";
import MusicPlayer from "@components/widgets/music-player/MusicPlayer.svelte";
import CodeGroupManager from "@/components/features/markdown/CodeGroupManager.astro";
import DiagramManager from "@/components/features/markdown/DiagramManager.astro";
import { pioConfig, profileConfig, siteConfig } from "@/config";

import { PAGE_WIDTH } from "../constants/constants";
import "../styles/main.css";
import "../styles/fancybox-custom.css";
import "../styles/expressive-code.css";
import "../styles/panel-animations.css";

import AnalyticsScripts from "./partials/AnalyticsScripts.astro";
import HeadTags from "./partials/HeadTags.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	coverImage?: string;
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	coverImage,
} = Astro.props;

const configHue = siteConfig.themeColor.hue;
const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";
const shouldShowTopHighlight =
	navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

const getDefaultBanner = (): string => {
	const src = siteConfig.banner.src;
	if (typeof src === "string") return src;
	if (Array.isArray(src)) return src[0] || "";
	if (src && typeof src === "object") {
		const desktopSrc = src.desktop;
		const mobileSrc = src.mobile;
		if (typeof desktopSrc === "string") return desktopSrc;
		if (Array.isArray(desktopSrc) && desktopSrc.length > 0) {
			return desktopSrc[0];
		}
		if (typeof mobileSrc === "string") return mobileSrc;
		if (Array.isArray(mobileSrc) && mobileSrc.length > 0) {
			return mobileSrc[0];
		}
	}
	return "";
};

if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = getDefaultBanner();
}
banner = getDefaultBanner();
const enableBanner = !!siteConfig.banner.src;

const pageTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;

let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
} else if (coverImage) {
	ogImageUrl = coverImage.startsWith("http")
		? coverImage
		: new URL(coverImage, Astro.site).toString();
} else if (banner) {
	ogImageUrl = banner.startsWith("http")
		? banner
		: new URL(banner, Astro.site).toString();
}

if (!lang) lang = `${siteConfig.lang}`;
const siteLang = lang.replace("_", "-");
---

<!doctype html>
<html
	lang={siteLang}
	class="katelya-art-theme bg-(--page-bg) text-[14px] md:text-[16px]"
	data-overlayscrollbars-initialize
	data-waves-config-enabled={siteConfig.banner?.waves?.enable ? "true" : "false"}
	data-banner-title-config-enabled={siteConfig.banner?.homeText?.enable ? "true" : "false"}
	data-post-list-layout-enabled={siteConfig.postListLayout?.enable ? "true" : "false"}
>
	<head>
		<meta charset="UTF-8" />
		<style is:inline>
			@layer properties, theme, base, components, utilities;
		</style>
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-cjk" />
		<Font cssVariable="--font-jetbrains-mono" />
		<script is:inline>
			(function() {
				try {
					var html = document.documentElement;
					var cw = html.getAttribute("data-waves-config-enabled");
					if (cw === "false") html.setAttribute("data-waves-enabled", "false");
					else {
						var rolloutKey = "katelyaWavesRolloutVersion";
						var rolloutVersion = "impasto-ribbons-v2";
						if (localStorage.getItem(rolloutKey) !== rolloutVersion) {
							localStorage.setItem("wavesEnabled", "true");
							localStorage.setItem(rolloutKey, rolloutVersion);
						}
						var w = localStorage.getItem("wavesEnabled");
						if (w !== null) html.setAttribute("data-waves-enabled", w);
					}
					var ct = html.getAttribute("data-banner-title-config-enabled");
					if (ct === "false") html.setAttribute("data-banner-title-enabled", "false");
					else {
						var t = localStorage.getItem("bannerTitleEnabled");
						if (t !== null) html.setAttribute("data-banner-title-enabled", t);
					}
				} catch(e) {}
			})();
		</script>
		<AnalyticsScripts thirdPartyAnalytics={siteConfig.thirdPartyAnalytics} />
		<HeadTags
			title={pageTitle}
			description={description}
			ogImageUrl={ogImageUrl}
			setOGTypeArticle={setOGTypeArticle}
			configHue={configHue}
		/>
		<slot name="head" />
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>
	</head>
	<body
		class="min-h-screen"
		class:list={[
			{
				"enable-banner": enableBanner,
				"enable-card-border": siteConfig.card?.border,
			},
		]}
		data-overlayscrollbars-initialize
	>
		<ImpastoBackdrop />
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-KRX3XGVH"
				height="0"
				width="0"
				style="display:none;visibility:hidden"
			></iframe>
		</noscript>
		{shouldShowTopHighlight && <div class="top-gradient-highlight" />}
		<ConfigCarrier />
		<PageProgressBar
			enable={siteConfig.pageProgressBar?.enable ?? false}
			height={siteConfig.pageProgressBar?.height ?? 3}
			duration={siteConfig.pageProgressBar?.duration ?? 8000}
		/>
		<slot />
		<MusicPlayer client:idle />
		{pioConfig.enable && <Pio config={pioConfig} />}
		<CodeGroupManager />
		<DiagramManager />
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<script>
	import { initSwupManager } from "../scripts/swup-manager";
	initSwupManager();
</script>
<script>
	import "../scripts/code-collapse.js";
</script>
<script>
	import "../scripts/theme-optimizer.js";
</script>
